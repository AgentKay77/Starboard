# Copy to /opt/starboard/.env and fill in real values.

# Required: 32+ random bytes for Flask session signing.
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SECRET_KEY=replace-me

# Email of the league commissioner. The first signup with this email is
# auto-promoted to admin. seed.py also reads ADMIN_USERNAME / ADMIN_PASSWORD
# to create or update the admin user without going through the signup flow.
ADMIN_EMAIL=you@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-me

# Path to the SQLite file. Relative paths resolve from WorkingDirectory.
DATABASE_PATH=/opt/starboard/starboard.db

# Feature flag — flip to true once you want signed-in users to self-submit
# times for their claimed player. Admin can always submit regardless.
ENABLE_USER_SUBMISSIONS=false

# IANA timezone used for week boundaries. Mondays at 00:00 in this zone
# open a new Skirmish; the close-out job locks the previous week.
WEEK_TIMEZONE=America/Chicago

# How many days back a non-admin can submit a late time. Admins are not
# subject to this limit.
SUBMISSION_LOOKBACK_DAYS=7
